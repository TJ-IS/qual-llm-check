{
  "schema_version": 1,
  "analysis_version": "ais-basket-individual-software-design-example-screening-v3",
  "input_dir": "../../database_fulltext_all",
  "output_dir": "output_v1",
  "env_file": "../../.env",
  "prompt_files": {
    "system": "system_prompt.md",
    "user_template": "user_prompt_template.md"
  },
  "selection": {
    "year_from": 2021,
    "year_to": 2025
  },
  "model": {
    "name": "deepseek-v4-flash",
    "api_key_env": "NEW_API_KEY",
    "base_url_env": "NEW_API_BASE_URL",
    "base_url": "https://api.deepseek.com",
    "temperature": 0,
    "max_tokens": 16000,
    "timeout_seconds": 300
  },
  "batch": {
    "max_concurrency": 50,
    "retries": 2,
    "retry_base_delay_seconds": 2.0
  }
}
