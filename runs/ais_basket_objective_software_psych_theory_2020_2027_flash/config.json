{
  "schema_version": 1,
  "analysis_version": "ais-basket-objective-software-psych-theory-2020-2027-flash-v1",
  "input_dir": "../../database_fulltext_all",
  "output_dir": "output_v1",
  "env_file": "../../.env",
  "year_range": {
    "from": 2020,
    "to": 2027
  },
  "prompt_files": {
    "system": "system_prompt_cn.md",
    "user_template": "user_prompt_template_cn.md"
  },
  "model": {
    "name": "deepseek-v4-flash",
