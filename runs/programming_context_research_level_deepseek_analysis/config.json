{
  "schema_version": 1,
  "analysis_version": "programming-context-research-level-v1",
  "input_dir": "../../database_fulltext_all",
  "source_matches_csv": "../programming_context_deepseek_analysis/output_v1_fresh/programming_context_matches.csv",
  "output_dir": "output_v1",
  "env_file": "../../.env",
  "prompt_files": {
    "system": "system_prompt.md",
    "user_template": "user_prompt_template.md",
    "chunk_system": "chunk_system_prompt.md"
  },
  "model": {
    "name": "deepseek-v4-pro",
