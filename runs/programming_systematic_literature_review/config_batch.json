{
  "schema_version": 1,
  "analysis_version": "programming-slr-title-abstract-batch-screen-v1",
  "input_dir": "input_metadata",
  "output_dir": "output_stage1_batch_v1",
  "env_file": "../../.env",
  "prompt_files": {
    "system": "system_prompt.md",
    "batch_append": "batch_prompt_append.md"
  },
  "model": {
    "name": "deepseek-v4-pro",
    "api_key_env": "NEW_API_KEY",
    "base_url_env": "NEW_API_BASE_URL",
    "base_url": "https://api.deepseek.com",
    "temperature": 0,
    "max_tokens": 24000,
    "timeout": 240
  },
  "batch": {
    "records_per_request": 16,
    "max_concurrency": 12,
    "retries": 3,
    "retry_base_delay": 2.0
  }
}
