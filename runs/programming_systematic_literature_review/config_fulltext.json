{
  "schema_version": 1,
  "analysis_version": "programming-slr-fulltext-code-v1",
  "input_dir": "fulltext_candidates_local",
  "output_dir": "output_fulltext_local_v1",
  "env_file": "../../.env",
  "prompt_files": {
    "system": "system_prompt_fulltext.md",
    "user_template": "user_prompt_fulltext.md",
    "chunk_system": "chunk_system_prompt_fulltext.md"
  },
  "model": {
    "name": "deepseek-v4-pro",
    "api_key_env": "NEW_API_KEY",
    "base_url_env": "NEW_API_BASE_URL",
    "base_url": "https://api.deepseek.com",
    "temperature": 0,
    "max_tokens": 5000,
    "chunk_max_tokens": 2400,
    "timeout": 300
  },
  "batch": {
    "max_concurrency": 8,
    "retries": 3,
    "retry_base_delay": 2.0,
    "direct_max_chars": null,
    "chunk_chars": 180000,
    "chunk_overlap_chars": 3000
  }
}
